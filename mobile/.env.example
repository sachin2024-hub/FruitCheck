# Copy to .env. EXPO_PUBLIC_* values are bundled into the app: only put PUBLIC values here
# (publishable/anon key). Never put the Supabase service-role key in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxx
# Leave empty in development (the app uses the Expo dev-server proxy). Set to an HTTPS URL for a deployed backend.
EXPO_PUBLIC_API_URL=
