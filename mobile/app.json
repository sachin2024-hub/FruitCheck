{
  "expo": {
    "name": "FruitCheck",
    "slug": "fruitcheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fruitcheck",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.fruitcheck.app",
      "adaptiveIcon": {
        "backgroundColor": "#2F7D4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FruitCheck uses the camera to photograph the fruit you want to classify.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FruitCheck reads your photos so you can classify an existing picture.",
          "cameraPermission": "FruitCheck uses the camera to photograph the fruit you want to classify.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F7D4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
